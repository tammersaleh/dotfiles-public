# Ghostty config, ported from the iTerm2 profile in ~/dotfiles/public/.iterm2.
# See README.md in this directory for what differs from iTerm2.
# Docs for the installed version: ghostty +show-config --default --docs

# Font: iTerm2 used "FiraCodeNFM-Reg 16" (Nerd Font Mono variant), ligatures on.
font-family = "FiraCode Nerd Font Mono"
font-size = 24

# iTerm2 forced its Dark appearance (Appearance > Theme: Dark), so the
# profile's dark color set was always in use. Theme files live in ./themes;
# iterm-light is the unused light set, kept for reference.
theme = iterm-dark

# iTerm2 "Use Bright Bold" and 50% faint text.
bold-color = bright
faint-opacity = 0.5

# iTerm2: blinking vertical bar.
cursor-style = bar
cursor-style-blink = true

# iTerm2 had unlimited scrollback. Ghostty caps scrollback in bytes per
# surface; the 10MB default is plenty for Claude-in-nvim (alt screen).

# iTerm2: "Option Key Sends: Normal" (no Meta). Set to true if you want
# Claude Code's Option+Enter / Option+P shortcuts.
macos-option-as-alt = false

# iTerm2: bell silenced, visual bell on. "border" flashes the surface.
bell-features = no-system,no-audio,no-attention,no-title,border

# iTerm2 split dimming was 10%.
unfocused-split-opacity = 0.9

# iTerm2 used TERM=xterm-256color. Ghostty uses xterm-ghostty, which remote
# hosts lack. ssh-env falls back to xterm-256color when you ssh out.
shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path

# Updates come from Homebrew (Brewfile has greedy: true), never from Ghostty.
auto-update = off

# Keybinds: Ghostty defaults cover iTerm2's (cmd+t, cmd+w, cmd+1..9,
# cmd+shift+[ ], cmd+k clears screen and scrollback, cmd+d split, cmd+enter
# fullscreen).
#
# iTerm2 had shift+enter -> LF and ctrl+shift+space -> CSI 27;6;32~. Both are
# unnecessary here: Ghostty, nvim's :terminal, and Claude Code all speak the
# kitty keyboard protocol, so those chords arrive intact. If shift+enter ever
# submits in Claude instead of inserting a newline, restore the iTerm2
# behavior with:
#   keybind = shift+enter=text:\n

# New tabs/windows start in $HOME instead of the focused tab's cwd.
window-inherit-working-directory = false

# Apps (nvim, mouse=a) never get mouse events, so cmd+click opens links
# without shift. Costs mouse support inside nvim: click-to-focus, wheel
# scroll of buffers, drag-resize. Wheel scroll still arrives as arrow keys.
mouse-reporting = false
