#!/usr/bin/env bash
#
# Pull secrets from 1Password into the macOS login keychain.
#
# The manifest (~/.config/secrets-sync/manifest) lists `ENV_VAR op://...`
# pairs. Each value is written to the login keychain as a generic password
# with service `secrets-sync.coreweave.<ENV_VAR>` and a fixed account, ACL'd
# to /usr/bin/security so shells can read it without a prompt
# (see ~/.zsh/d/secrets.zsh). Run by hand on a new Mac and after rotating a
# credential. Never from shell startup or a scheduled job: `op` prompts.
#
# All values are resolved from 1Password before anything is written, so a
# failure leaves the keychain untouched. Values pass to `security` via argv
# (`-w`), which is briefly visible to same-UID processes; accepted.

set -Eeu
shopt -s inherit_errexit
trap 'echo "$0 failed at line $LINENO: $BASH_COMMAND" >&2' ERR

ACCOUNT=coreweave.1password.com
NAMESPACE=secrets-sync.coreweave
KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
MANIFEST="${SECRETS_MANIFEST:-$HOME/.config/secrets-sync/manifest}"

check=false
verbose=false

usage() {
  [[ $# -eq 0 ]] || echo "Error: $*" >&2
  cat >&2 <<USAGE
Usage: $(basename "$0") [--check] [--verbose]

  --check    Compare keychain to 1Password; report ok/missing/different. No writes.
  --verbose  Print each entry's status when writing.

Manifest: $MANIFEST
USAGE
  exit 2
}

log() { $verbose && echo "$*" || true; }

for arg in "$@"; do
  case "$arg" in
    --check) check=true ;;
    --verbose | -v) verbose=true ;;
    -h | --help) usage ;;
    *) usage "Unknown argument: $arg" ;;
  esac
done

[[ -r "$MANIFEST" ]] || usage "Manifest not readable: $MANIFEST"
command -v op > /dev/null || usage "op (1Password CLI) not on PATH"

declare -a vars=()
declare -A refs=()
while read -r var ref extra; do
  [[ -z "$var" || "$var" == \#* ]] && continue
  [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || usage "Bad variable name in manifest: $var"
  [[ "$ref" == op://* ]] || usage "Bad reference for $var: ${ref:-<missing>}"
  [[ -z "$extra" ]] || usage "Trailing text for $var: $extra"
  [[ -v refs[$var] ]] && usage "Duplicate variable in manifest: $var"
  vars+=("$var")
  refs[$var]="$ref"
done < "$MANIFEST"
[[ ${#vars[@]} -gt 0 ]] || usage "Manifest is empty"

# Phase 1: resolve everything. No keychain writes until all succeed.
declare -A values=()
errors=0
for var in "${vars[@]}"; do
  if ! value=$(op read --account "$ACCOUNT" --no-newline "${refs[$var]}" 2> /dev/null); then
    echo "$var: error reading ${refs[$var]}" >&2
    errors=$((errors + 1))
    continue
  fi
  if [[ -z "$value" ]]; then
    echo "$var: empty value in 1Password" >&2
    errors=$((errors + 1))
    continue
  fi
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "$var: value contains a line break" >&2
    errors=$((errors + 1))
    continue
  fi
  values[$var]="$value"
done
if [[ $errors -gt 0 ]]; then
  echo "$errors error(s) resolving 1Password values. Nothing written." >&2
  exit 1
fi

kc_read() {
  security find-generic-password -a "$ACCOUNT" -s "$NAMESPACE.$1" -w "$KEYCHAIN" 2> /dev/null
}

# Phase 2: check or write.
if $check; then
  bad=0
  for var in "${vars[@]}"; do
    if ! current=$(kc_read "$var"); then
      echo "$var: missing"; bad=$((bad + 1))
    elif [[ "$current" != "${values[$var]}" ]]; then
      echo "$var: different"; bad=$((bad + 1))
    else
      echo "$var: ok"
    fi
  done
  if (( bad > 0 )); then
    echo "$bad entr$([[ $bad -eq 1 ]] && echo y || echo ies) out of sync. Run secrets-sync." >&2
    exit 1
  fi
  exit 0
fi

failed=0
for var in "${vars[@]}"; do
  if security add-generic-password -U -a "$ACCOUNT" -s "$NAMESPACE.$var" \
    -w "${values[$var]}" -T /usr/bin/security "$KEYCHAIN" 2> /dev/null; then
    log "$var: written"
  else
    echo "$var: keychain write failed" >&2
    failed=$((failed + 1))
  fi
done
if [[ $failed -gt 0 ]]; then
  echo "$failed keychain write(s) failed. Rerun to retry." >&2
  exit 1
fi
echo "${#vars[@]} secrets synced to the login keychain."
